# JSON mapping station names to unique, secret tokens.
STATION_TOKENS={"WORKSTATION":"replace-with-a-unique-random-token-at-least-32-chars"}

# Browser origins allowed to access the REST API and Socket.IO.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# User authentication sessions expire after this many hours (1-720).
AUTH_SESSION_TTL_HOURS=8

# Set only while creating the first administrator with `pnpm --filter @samsung-maintenance/api create-admin`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
