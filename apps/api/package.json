{
  "name": "@samsung-maintenance/api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm --filter @samsung-maintenance/shared build && tsc",
    "dev": "pnpm --filter @samsung-maintenance/shared build && tsx watch src/server.ts",
    "test": "pnpm --filter @samsung-maintenance/shared build && tsx --test src/auth.test.ts src/diagnostic.test.ts src/maintenance.test.ts src/device-sync.test.ts src/station-auth.test.ts src/socket-handlers.test.ts",
    "create-admin": "pnpm --filter @samsung-maintenance/shared build && tsx src/create-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "@samsung-maintenance/shared": "workspace:*",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "prisma": "^5.9.0",
    "socket.io-client": "^4.7.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.7.17"
  }
}