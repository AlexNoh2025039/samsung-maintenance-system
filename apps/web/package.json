{
  "name": "@samsung-maintenance/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @samsung-maintenance/shared build && vite --host 127.0.0.1",
    "build": "pnpm --filter @samsung-maintenance/shared build && tsc --noEmit && vite build",
    "test": "pnpm --filter @samsung-maintenance/shared build && vitest run",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@samsung-maintenance/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.3.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
